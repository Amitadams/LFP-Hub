<Window x:Class="LfpHub.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LFP Hub - First-time setup"
        Height="560" Width="520"
        MinHeight="480" MinWidth="440"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Icon="pack://application:,,,/Assets/LfpHub.ico">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <TextBlock x:Name="ErrText" Foreground="{DynamicResource DangerBrush}"
                 FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Button x:Name="BtnContinue" Content="Continue" Click="BtnContinue_Click"
              Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
              Height="42" FontSize="14.5"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Welcome to LFP Hub" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,18"
                   Text="Enter your tech identity for Teams replies and ITA notes. Display name and username are required."/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Display name"/>
        <TextBox x:Name="TxtDisplayName" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Username"/>
        <TextBox x:Name="TxtUsername" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Email"/>
        <TextBox x:Name="TxtEmail" Margin="0,0,0,12"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Site"/>
            <TextBox x:Name="TxtSite" Text="GFNV"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Walk-up hours"/>
            <TextBox x:Name="TxtWalkupHours" Text="7:00 AM - 7:00 PM"/>
          </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="Signature title"/>
        <TextBox x:Name="TxtSignatureTitle" Text="Tesla IT Support - GFNV"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
