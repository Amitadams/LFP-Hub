<Window x:Class="LfpHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LFP Hub"
        Height="820" Width="720"
        MinHeight="660" MinWidth="580"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/LfpHub.ico">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1">
      <DockPanel Margin="18,12">
        <Button DockPanel.Dock="Right" Content="Settings" Click="BtnSettings_Click"
                Style="{StaticResource GhostButton}" Padding="14,8" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="LFP Hub" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                     Text="TeslaLFP close-out and open MFA tickets · GFNV"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="16,10">
      <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                 FontSize="12.5" Text="Ready" TextTrimming="CharacterEllipsis"/>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Username"/>
                <TextBox x:Name="TxtUsername"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="ITA"/>
                <TextBox x:Name="TxtIta"/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Name"/>
                <TextBox x:Name="TxtName"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Badge"/>
                <TextBox x:Name="TxtBadge"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Job"/>
            <UniformGrid Columns="2" Margin="0,0,0,10">
              <RadioButton x:Name="RadJobCloseout" Content="Close-out" IsChecked="True"
                           GroupName="Job" Margin="0,0,8,0" Checked="Job_Changed"/>
              <RadioButton x:Name="RadJobMfaTicket" Content="Open MFA ticket"
                           GroupName="Job" Checked="Job_Changed"/>
            </UniformGrid>

            <StackPanel x:Name="CloseoutTypePanel">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Type"/>
              <UniformGrid Columns="3">
                <RadioButton x:Name="RadPassword" Content="Password" IsChecked="True"
                             GroupName="Mode" Margin="0,0,8,0" Checked="Mode_Changed"/>
                <RadioButton x:Name="RadSetup" Content="First login" GroupName="Mode"
                             Margin="0,0,8,0" Checked="Mode_Changed"/>
                <RadioButton x:Name="RadMfa" Content="MFA" GroupName="Mode"
                             Checked="Mode_Changed"/>
              </UniformGrid>
            </StackPanel>

            <StackPanel x:Name="TempPanel" Margin="0,14,0,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="One-time password"/>
              <PasswordBox x:Name="TxtTemp"/>
            </StackPanel>

            <StackPanel x:Name="MfaTicketPanel" Margin="0,4,0,0" Visibility="Collapsed">
              <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                         Text="Creates an open ITA with component MFA - Reset, then opens it for misc follow-up. Does not Teams or close."/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Notes (optional)"/>
              <TextBox x:Name="TxtNotes" AcceptsReturn="True" TextWrapping="Wrap"
                       Height="72" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <CheckBox x:Name="ChkDryRun" Content="Dry-run" IsChecked="True"/>
              <CheckBox x:Name="ChkVisible" Content="Show browser"/>
              <StackPanel x:Name="CloseoutOptionsPanel">
                <CheckBox x:Name="ChkNoTeams" Content="Skip Teams"/>
                <CheckBox x:Name="ChkNoClose" Content="Leave ITA open" Margin="0"/>
              </StackPanel>
              <StackPanel x:Name="MfaTicketOptionsPanel" Visibility="Collapsed">
                <CheckBox x:Name="ChkNoOpen" Content="Do not open browser" Margin="0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" MinWidth="180">
              <TextBlock x:Name="ErrText" Foreground="{StaticResource DangerBrush}"
                         FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"
                         MaxWidth="200" HorizontalAlignment="Right"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRun" Content="Run" Click="BtnRun_Click"
                        Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                <Button x:Name="BtnStop" Content="Stop" Click="BtnStop_Click"
                        Style="{StaticResource GhostButton}"
                        MinWidth="90" Margin="8,0,0,0" IsEnabled="False"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource LogBgBrush}"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                CornerRadius="12" Padding="2" MinHeight="200">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
              <TextBlock Text="Log" Foreground="{StaticResource MutedBrush}"
                         FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Clear" Click="BtnClearLog_Click"
                      Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                      HorizontalAlignment="Right"/>
            </DockPanel>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                     Background="Transparent" BorderThickness="0"
                     Padding="12,4,12,12" AcceptsReturn="True"
                     Foreground="{StaticResource MutedBrush}"/>
          </DockPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
