<Window x:Class="LfpHub.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="720" Width="800"
        MinHeight="560" MinWidth="640"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="18">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                 Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" MinWidth="100"/>
        <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource GhostButton}"
                MinWidth="90" Margin="8,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <TabControl Background="Transparent" BorderThickness="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
          <Setter Property="FontSize" Value="13.5"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Padding" Value="14,8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,6,8">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipActiveBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>

      <TabItem Header="Appearance">
        <Border Style="{StaticResource Card}" Margin="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                         Text="Pick a skin. Preview updates immediately; Save keeps it for next launch."/>
              <StackPanel x:Name="ThemeRadios"/>
              <TextBlock x:Name="TxtThemeBlurb" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="Tech identity">
        <Border Style="{StaticResource Card}" Margin="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                         Text="Used in reply signatures, ITA assignee, and ticket notes. Not committed with the app."/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Display name"/>
                  <TextBox x:Name="TxtDisplayName" TextChanged="Field_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Username"/>
                  <TextBox x:Name="TxtTechUsername" TextChanged="Field_Changed"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Email"/>
                  <TextBox x:Name="TxtEmail" TextChanged="Field_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Site"/>
                  <TextBox x:Name="TxtSite" TextChanged="Field_Changed"/>
                </StackPanel>
              </Grid>
              <StackPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Signature title"/>
                <TextBox x:Name="TxtSignatureTitle" TextChanged="Field_Changed"/>
              </StackPanel>
              <StackPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Walk-up hours"/>
                <TextBox x:Name="TxtWalkupHours" TextChanged="Field_Changed"/>
              </StackPanel>
              <TextBlock Style="{StaticResource HintText}" Margin="0,14,0,0"
                         Text="Template tokens: [TechName] [SignatureTitle] [WalkupHours] [Site]"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="Templates">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Templates folder"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtTemplatesDir" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="14,8"/>
                <Button Grid.Column="2" Content="Reset default" Click="BtnResetDir_Click"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="14,8"/>
              </Grid>
              <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                         Text="Tokens: [User] [username] [PASSWORD] [TechName] [SignatureTitle] [WalkupHours] [Site]"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="12">
            <DockPanel>
              <ListBox x:Name="TemplateList" DockPanel.Dock="Left" Width="180"
                       Background="{DynamicResource InputBgBrush}"
                       BorderBrush="{DynamicResource BorderBrushKey}"
                       BorderThickness="1" Padding="4"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="13.5"
                       SelectionChanged="TemplateList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                  Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
              <TextBox x:Name="TxtTemplateBody" Margin="12,0,0,0"
                       AcceptsReturn="True" AcceptsTab="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       FontFamily="{StaticResource MonoFont}" FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       TextChanged="TemplateBody_Changed"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
